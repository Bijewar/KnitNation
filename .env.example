# ==========================================
# KnitNations Environment Configuration Template
# Copy this file to .env.local:
# cp .env.example .env.local
# ==========================================

# 1. Supabase Configuration (Primary Database & Storage)
# (Obtain from: Supabase Console > Project Settings > API)
NEXT_PUBLIC_SUPABASE_URL=https://your-project-id.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-supabase-anon-key

# 2. Admin Email (For /addproduct Dashboard access)
NEXT_PUBLIC_ADMIN_EMAIL=bijewarmanas1@gmail.com

# 3. Application Base URL
NEXT_PUBLIC_BASE_URL=http://localhost:3000

# 4. Razorpay Payments (Used in /api/startpay & /api/verify-payment)
RAZORPAY_KEY_ID=your_razorpay_key_id
RAZORPAY_KEY_SECRET=your_razorpay_key_secret

# 5. Gmail OTP Service (Used in /api/sendOtp)
EMAIL_USER=your_email@gmail.com
EMAIL_PASS=your_gmail_app_password

# 6. Cashfree Payments (Optional / Legacy)
NEXT_PUBLIC_CASHFREE_CLIENT_ID=your_cashfree_client_id
NEXT_PUBLIC_CASHFREE_CLIENT_SECRET=your_cashfree_client_secret
